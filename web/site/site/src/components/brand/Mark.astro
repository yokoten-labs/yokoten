---
// The guard (owner, 2026-10-28): a y cut out of a stop-sign octagon, in one colour that follows the theme.
// The drawing lives in tools/steps/mark.mjs, so the header, the browser icon and the share images
// can't drift apart: one drawing at every size.
import { nextId, guardInner } from '../../../../tools/steps/mark.mjs';
interface Props { size?: number; class?: string }
const { size = 28, class: cls } = Astro.props;
const id = nextId();
---
<svg class={cls} width={size} height={size} viewBox="0 0 512 512" aria-hidden="true" focusable="false" set:html={guardInner({ id })} />
