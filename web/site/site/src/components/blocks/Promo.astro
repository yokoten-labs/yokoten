---
// The promo film, on the home page, with its own toolbar: play, position, the four caption
// languages behind one CC button that opens them, sound and full screen. Without script the browser's
// own controls stay on, so the film still plays. The page's language picks the first captions.
import { LANG_INFO, LANGS, type Lang } from '../../lib/i18n';
import { PROMO } from '../../lib/content/facts';
type Controls = { play: string; pause: string; mute: string; unmute: string; fullscreen: string; captions: string; off: string; seek: string };
interface Props { lang: Lang; label: string; fallback: string; download: string; controls: Controls }
const { lang, label, fallback, download, controls: c } = Astro.props;
const dark = PROMO.dark;
const time = (s: number) => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`;
---
<figure class="promo" data-promo data-light={JSON.stringify([PROMO.webm, PROMO.mp4, PROMO.poster])} data-dark={JSON.stringify([dark.webm, dark.mp4, dark.poster])} data-play={c.play} data-pause={c.pause} data-mute={c.mute} data-unmute={c.unmute}>
  <video controls preload="none" playsinline poster={PROMO.poster} aria-label={label} width="1920" height="1080">
    <source src={PROMO.webm} type="video/webm" />
    <source src={PROMO.mp4} type="video/mp4" />
    {LANGS.map((l) => <track kind="captions" src={PROMO.captions[l]} srclang={LANG_INFO[l].html} label={LANG_INFO[l].name} default={l === lang} />)}
    <p>{fallback} <a href={PROMO.mp4} download>{download}</a></p>
  </video>
  <div class="bar" hidden>
    <input class="seek" type="range" min="0" max={PROMO.seconds} step="0.1" value="0" aria-label={c.seek} />
    <div class="ctl">
      <button class="btn play" type="button" aria-label={c.play} title={c.play}>
        <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" /></svg>
        <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" /></svg>
      </button>
      <span class="time"><span class="now">0:00</span> / {time(PROMO.seconds)}</span>
      <div class="cc">
        <button class="btn cc-btn" type="button" aria-label={c.captions} title={c.captions} aria-expanded="false" aria-haspopup="true">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M10.5 10.2a2.2 2.2 0 1 0 0 3.6M16.5 10.2a2.2 2.2 0 1 0 0 3.6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
        </button>
        <div class="cc-menu" role="group" aria-label={c.captions} hidden>
          {LANGS.map((l) => <button class="lang" type="button" data-lang={LANG_INFO[l].html} lang={LANG_INFO[l].html} aria-pressed={l === lang ? 'true' : 'false'}>{LANG_INFO[l].name}</button>)}
          <button class="lang" type="button" data-lang="" aria-pressed="false">{c.off}</button>
        </div>
      </div>
      <button class="btn sound" type="button" aria-label={c.mute} title={c.mute}>
        <svg class="i-on" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" /><path d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
        <svg class="i-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" /><path d="M16 9.5l5 5M21 9.5l-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
      </button>
      <button class="btn full" type="button" aria-label={c.fullscreen} title={c.fullscreen}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
    </div>
  </div>
</figure>
<script>
  for (const fig of document.querySelectorAll<HTMLElement>('[data-promo]')) {
    const video = fig.querySelector('video')!;
    const bar = fig.querySelector<HTMLElement>('.bar')!;
    const seek = fig.querySelector<HTMLInputElement>('.seek')!;
    const now = fig.querySelector<HTMLElement>('.now')!;
    const play = fig.querySelector<HTMLButtonElement>('.play')!;
    const sound = fig.querySelector<HTMLButtonElement>('.sound')!;
    const full = fig.querySelector<HTMLButtonElement>('.full')!;
    const langs = [...fig.querySelectorAll<HTMLButtonElement>('.lang')];
    const ccBtn = fig.querySelector<HTMLButtonElement>('.cc-btn')!;
    const ccMenu = fig.querySelector<HTMLElement>('.cc-menu')!;
    const d = fig.dataset;
    // The film is rendered twice, on a white page and on a black one; it follows the page theme.
    const sources = [...video.querySelectorAll('source')];
    const html = document.documentElement;
    const system = matchMedia('(prefers-color-scheme: dark)');
    const follow = () => {
      const isDark = (html.dataset.theme ?? (system.matches ? 'dark' : 'light')) === 'dark';
      const [webm, mp4, poster] = JSON.parse((isDark ? d.dark : d.light)!) as string[];
      if (sources[0]!.getAttribute('src') === webm) return;
      const at = video.currentTime;
      const playing = !video.paused;
      const started = video.currentSrc !== '';
      sources[0]!.src = webm;
      sources[1]!.src = mp4;
      video.poster = poster!;
      if (!started) return;
      video.load();
      video.currentTime = at;
      if (playing) void video.play();
    };
    follow();
    system.addEventListener('change', follow);
    new MutationObserver(follow).observe(html, { attributes: true, attributeFilter: ['data-theme'] });
    const name = (b: HTMLButtonElement, s: string) => { b.setAttribute('aria-label', s); b.title = s; };
    const clock = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;

    video.controls = false;
    bar.hidden = false;

    const toggle = () => (video.paused || video.ended ? video.play() : video.pause());
    play.addEventListener('click', toggle);
    video.addEventListener('click', toggle);
    const state = () => {
      fig.classList.toggle('playing', !video.paused);
      name(play, video.paused ? d.play! : d.pause!);
    };
    video.addEventListener('play', state);
    video.addEventListener('pause', state);

    // the position: smooth while playing, and the track's fill drawn from --p
    let frame = 0;
    const draw = () => {
      seek.value = String(video.currentTime);
      fig.style.setProperty('--p', String(video.currentTime / Number(seek.max)));
      now.textContent = clock(video.currentTime);
      if (!video.paused) frame = requestAnimationFrame(draw);
    };
    video.addEventListener('play', () => { cancelAnimationFrame(frame); draw(); });
    video.addEventListener('timeupdate', () => { if (video.paused) draw(); });
    seek.addEventListener('input', () => { video.currentTime = Number(seek.value); draw(); });

    sound.addEventListener('click', () => {
      video.muted = !video.muted;
      fig.classList.toggle('muted', video.muted);
      name(sound, video.muted ? d.unmute! : d.mute!);
    });

    // captions: CC opens the list; the picked track shows, every other one is off, and the list closes
    const open = (on: boolean) => { ccMenu.hidden = !on; ccBtn.setAttribute('aria-expanded', String(on)); };
    // hidden is a boolean or 'until-found'; the menu only ever sets true or false
    ccBtn.addEventListener('click', () => open(ccMenu.hidden !== false));
    document.addEventListener('click', (e) => { if (!fig.querySelector('.cc')!.contains(e.target as Node)) open(false); });
    fig.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !ccMenu.hidden) { open(false); ccBtn.focus(); } });
    const pick = (tag: string) => {
      for (const t of video.textTracks) t.mode = t.language === tag ? 'showing' : 'disabled';
      for (const b of langs) b.setAttribute('aria-pressed', String(b.dataset.lang === tag));
      fig.classList.toggle('captioned', tag !== '');
    };
    for (const b of langs) b.addEventListener('click', () => { pick(b.dataset.lang!); open(false); });
    pick(langs.find((b) => b.getAttribute('aria-pressed') === 'true')?.dataset.lang ?? '');

    // full screen keeps this toolbar; a phone without it gets the system player
    full.addEventListener('click', () => {
      if (document.fullscreenElement) return void document.exitFullscreen();
      if (fig.requestFullscreen) return void fig.requestFullscreen().catch(() => {});
      (video as HTMLVideoElement & { webkitEnterFullscreen?: () => void }).webkitEnterFullscreen?.();
    });
  }
</script>
<style>
  .promo { --p: 0; margin: 2.5rem 0 0; background: var(--term); color: var(--term-fg); border-radius: 12px; overflow: hidden; border: 1px solid var(--line); }
  video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; background: var(--term); cursor: pointer; }
  .bar { display: grid; gap: 0.5rem; padding: 0.625rem 0.875rem 0.75rem; }
  .ctl { display: flex; align-items: center; gap: 0.5rem; }

  .btn, .lang { display: inline-grid; place-items: center; min-width: 2.25rem; height: 2.25rem; padding: 0; border: 0; border-radius: 8px; background: transparent; color: var(--term-fg); cursor: pointer; }
  .btn svg { width: 1.375rem; height: 1.375rem; fill: currentColor; }
  .btn:hover, .lang:hover { background: rgb(255 255 255 / 0.1); }
  .btn:focus-visible, .lang:focus-visible, .seek:focus-visible { outline: 2px solid var(--link); outline-offset: 2px; }
  .i-pause, .playing .i-play, .i-off, .muted .i-on { display: none; }
  .playing .i-pause, .muted .i-off { display: block; }

  .time { font-family: var(--font-mono); font-size: 0.8125rem; color: var(--term-dim); font-variant-numeric: tabular-nums; white-space: nowrap; }
  /* CC: dim while captions are off; its list opens above it */
  .cc { position: relative; margin-left: auto; }
  .cc-btn { color: var(--term-dim); }
  .captioned .cc-btn { color: var(--term-fg); }
  .cc-menu { position: absolute; right: 0; bottom: calc(100% + 0.5rem); z-index: 2; display: grid; min-width: 9rem; padding: 0.25rem; border-radius: 8px; background: #1a1a1a; border: 1px solid rgb(255 255 255 / 0.12); box-shadow: 0 8px 24px rgb(0 0 0 / 0.4); }
  .lang { justify-items: start; width: 100%; padding: 0 0.75rem; font: 500 0.875rem/1 var(--font-sans); color: var(--term-fg); white-space: nowrap; }
  .lang[aria-pressed='true']::after { content: '✓'; justify-self: end; color: var(--term-green); }
  .lang { grid-template-columns: 1fr auto; gap: 1rem; }

  /* the position: a thin track that thickens under the pointer, filled in red up to now */
  .seek { appearance: none; width: 100%; height: 1rem; margin: 0; background: transparent; cursor: pointer; }
  .seek::-webkit-slider-runnable-track { height: 4px; border-radius: 2px; background: linear-gradient(to right, var(--cyan) calc(var(--p) * 100%), rgb(255 255 255 / 0.2) 0); }
  .seek::-moz-range-track { height: 4px; border-radius: 2px; background: linear-gradient(to right, var(--cyan) calc(var(--p) * 100%), rgb(255 255 255 / 0.2) 0); }
  .seek::-webkit-slider-thumb { appearance: none; width: 14px; height: 14px; margin-top: -5px; border-radius: 50%; background: var(--paper); border: 0; }
  .seek::-moz-range-thumb { width: 14px; height: 14px; border-radius: 50%; background: var(--paper); border: 0; }

  .promo:fullscreen { display: flex; flex-direction: column; justify-content: center; border-radius: 0; background: #000; }
  .promo:fullscreen video { flex: 1; min-height: 0; height: auto; aspect-ratio: auto; object-fit: contain; background: #000; }
  .promo:fullscreen .bar { background: var(--term); }

  @media (max-width: 30rem) {
    .bar { padding-inline: 0.5rem; }
    .ctl { gap: 0.125rem; }
    .time { display: none; }
  }
</style>
