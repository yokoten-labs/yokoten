---
// A command to type (`npx yokoten` unless told), with a copy button. public/js/theme.js shows the button and wires it;
// without script the command is still plain, selectable text.
import type { CollectionEntry } from 'astro:content';
interface Props { t: CollectionEntry<'site'>['data']; size?: 'lg' | 'md'; command?: string }
const { t, size = 'md', command = 'npx yokoten' } = Astro.props;
---
<div class:list={['cmd-copy', `cmd-${size}`]}>
  <code class="cmd"><span class="prompt" aria-hidden="true">$</span>{command}</code>
  <button type="button" class="copy" data-copy={command} aria-label={t.copy.label} title={t.copy.label} hidden>
    <svg class="i-copy" width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><rect x="6.5" y="6.5" width="10" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M13.5 4.5v-.5a1.5 1.5 0 0 0-1.5-1.5H5A1.5 1.5 0 0 0 3.5 4v7A1.5 1.5 0 0 0 5 12.5h.5" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
    <svg class="i-done" width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><path d="m4.5 10.5 3.5 3.5 7.5-8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    <span class="done" role="status">{t.copy.done}</span>
  </button>
</div>
<style>
  .cmd-copy { display: inline-flex; align-items: stretch; background: var(--term); color: var(--term-fg); border-radius: 12px; box-shadow: var(--shadow); max-width: 100%; }
  .cmd-copy .cmd { background: none; box-shadow: none; border: 0; border-radius: 0; padding: 0.95rem 0.5rem 0.95rem 1.4rem; }
  .cmd-lg .cmd { font-size: 1rem; padding: 0.7rem 0.4rem 0.7rem 1.1rem; }
  .cmd-lg .copy { width: 2.75rem; }
  /* a thin edge, so the box keeps its shape on the black page */
  .cmd-lg { box-shadow: 0 0 0 1px var(--line), var(--shadow); }
  /* In the docs (md), a code block as Vercel and Google docs draw one: the width of the text, the
     page's own colours, small mono type and the copy button at the right end. */
  .cmd-md { display: flex; width: 100%; background: var(--band); color: var(--fg); border: 1px solid var(--line); border-radius: 8px; box-shadow: none; }
  .cmd-md .cmd { flex: 1; font-size: 0.875rem; padding: 0.7rem 0.5rem 0.7rem 1rem; color: var(--fg); }
  .cmd-md .cmd :global(.prompt) { color: var(--muted); }
  .cmd-md .copy { width: 2.5rem; border-left: 0; border-radius: 0 8px 8px 0; color: var(--muted); }
  .cmd-md .copy:hover { color: var(--fg); background: var(--raised); }
  .copy { position: relative; display: inline-grid; place-items: center; width: 3.25rem; background: none; border: 0; border-left: 1px solid rgb(255 255 255 / 0.08); color: var(--term-dim); cursor: pointer; border-radius: 0 10px 10px 0; }
  .copy:hover { color: var(--term-fg); background: rgb(255 255 255 / 0.05); }
  .i-done, .done { display: none; }
  .copy[data-done] .i-copy { display: none; }
  .copy[data-done] .i-done { display: block; color: var(--term-green); }
  .copy[data-done] .done { display: block; position: absolute; bottom: calc(100% + 0.5rem); right: 0; white-space: nowrap; font-family: var(--font-sans); font-size: 0.8rem; background: var(--fg); color: var(--bg); padding: 0.25rem 0.55rem; border-radius: 6px; }
</style>
