---
// The 404 page, in English; public/js/theme.js sets <html lang> and the title for the visitor's language.
import Sheet from '../layouts/Sheet.astro';
import { href } from '../lib/i18n';
---
<Sheet lang="en" page="404" title="Page not found · yokoten" description="This page does not exist on yokoten.app.">
  <section id="not-found" class="nf" aria-labelledby="nf-title">
    <p class="eyebrow">404</p>
    <h1 id="nf-title" class="page-title">Page not found</h1>
    <p class="lede"><a href={href('home', 'en')}>yokoten.app</a> · <a href={href('home', 'zh')}>简体中文</a> · <a href={href('home', 'tw')}>繁體中文</a> · <a href={href('home', 'ja')}>日本語</a></p>
  </section>
</Sheet>
<style>
  .nf { padding-block: 5rem; }
</style>
