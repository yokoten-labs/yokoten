{
  "name": "yokoten-site",
  "version": "0.1.0",
  "private": true,
  "description": "The website for yokoten, served at yokoten.app.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev --root site",
    "build": "node tools/steps/mark.mjs && node tools/steps/how-flow.mjs && node tools/steps/video-sizes.mjs && npm run site:facts && astro build --root site && npm run i18n",
    "i18n": "node tools/steps/i18n-check.mjs",
    "preview": "astro preview --root site --host --port 4173",
    "deploy": "npm run build && wrangler deploy --config worker/wrangler.jsonc",
    "check": "tsc --noEmit -p tools && astro check --root site",
    "visits": "node tools/stats/visits.mjs",
    "stays": "node tools/stats/stays.mjs",
    "site:facts": "node --experimental-strip-types tools/steps/from-package.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@fontsource-variable/noto-sans-tc": "5.3.1",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@lobehub/icons-static-svg": "1.101.0",
    "@tailwindcss/vite": "4.3.3",
    "github-slugger": "2.0.0",
    "simple-icons": "16.35.0",
    "subset-font": "2.9.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wrangler": "4.135.0"
  }
}
