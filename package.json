{
  "name": "yokoten",
  "version": "0.1.2",
  "description": "A safety guard for AI coding tools. AI agents can make a big mistake in a second. yokoten stops it before it happens.",
  "keywords": [
    "ai-agents",
    "guardrails",
    "git-hooks",
    "sdlc",
    "code-review",
    "claude-code",
    "codex",
    "github-copilot",
    "antigravity",
    "deepseek",
    "grok",
    "opencode",
    "muse-code",
    "ai-safety"
  ],
  "license": "MIT",
  "homepage": "https://yokoten.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yokoten-labs/yokoten.git"
  },
  "bugs": {
    "url": "https://github.com/yokoten-labs/yokoten/issues"
  },
  "type": "module",
  "bin": {
    "yokoten": "dist/bin/yokoten.js"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc",
    "check": "node bin/yokoten.ts check",
    "build": "node scripts/build.ts",
    "prepack": "node scripts/build.ts",
    "check-package": "node scripts/check-package.ts"
  },
  "files": [
    "bin",
    "src",
    "kit",
    "dist"
  ],
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jscpd": "5.4.2",
    "typescript": "^7.0.2"
  }
}
