{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/bin/yokoten.ts\" hook"
          }
        ],
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/bin/yokoten.ts\" hook --stop"
          }
        ]
      }
    ]
  },
  "env": {
    "TZ": "UTC",
    "NODE_USE_ENV_PROXY": "1"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": ["github.com", "api.github.com", "registry.npmjs.org"]
    }
  }
}
